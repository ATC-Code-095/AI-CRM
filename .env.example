# API 配置。复制为 apps/api/.env 后修改（Prisma 命令与 API 都从 apps/api 目录读取）。
# 下面的数据库与 Redis 地址对应 docker-compose.dev.yml；生产环境请全部替换。
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://crm:crm@localhost:5432/ai_crm
# 可选：仅用于健康检查显示，不配置不影响使用
REDIS_URL=redis://localhost:6379

# 登录令牌签名密钥：生产环境必须改成两个不同的随机串（openssl rand -hex 32）
JWT_ACCESS_SECRET=dev-access-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-change-me
JWT_REFRESH_TTL=7d

# 允许跨域访问的网页地址，逗号分隔（网页与 API 同源部署时无需修改）
CORS_ORIGIN=http://localhost:5174,http://127.0.0.1:5174
# 每个 IP 每分钟登录次数上限
LOGIN_RATE_LIMIT=20
# true：启动时写入角色、权限与初始账号（仅首次或开发环境）
AUTO_SEED=false
# 初始账号密码：留空时开发环境用演示密码，NODE_ENV=production 时随机生成并只显示一次
SEED_PASSWORD=
# 附件存放目录
FILE_STORAGE_DIR=./storage

# 加密存库的第三方密钥（企业微信 / 钉钉 / 飞书应用密钥等）；设置后不要更换
SETTINGS_SECRET=


# 手机推送（可选）：iOS APNs .p8 密钥与 Android Firebase 服务账号，见 docs/18-mobile-build.md
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.itecent.crm
APNS_PRODUCTION=false
FCM_SERVICE_ACCOUNT_FILE=
HMS_SERVICE_ACCOUNT_FILE=
