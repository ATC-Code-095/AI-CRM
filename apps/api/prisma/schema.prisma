// ZhiXiao-CRM Prisma Schema — aligned with docs/04 + 12/13
// Do not alter DB by hand; use prisma migrate

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== M01 组织 ==========

model Tenant {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  defaultLocale String    @default("zh-CN")
  status        String    @default("ACTIVE") // ACTIVE | SUSPENDED
  expireAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  users       User[]
  departments Department[]
  leads       Lead[]
  accounts    Account[]
  settings    Setting[]
}

model Department {
  id               String    @id @default(cuid())
  tenantId         String
  name             String
  parentId         String?
  code             String?
  path             String
  managerId        String?
  sortOrder        Int       @default(0)
  /// 通讯录同步来源：wechat_work | dingtalk | feishu，与 externalId 一起对应平台部门
  externalProvider String?
  externalId       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  parent   Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children Department[] @relation("DeptTree")
  users    User[]

  @@unique([tenantId, code])
  @@unique([tenantId, externalProvider, externalId])
  @@index([tenantId, deletedAt])
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  phone        String?
  avatarUrl    String?
  status       String    @default("ACTIVE") // ACTIVE | DISABLED
  departmentId String?
  managerId    String?
  title        String?
  dataScope    String    @default("SELF") // SELF|TEAM|DEPARTMENT|ALL|CUSTOM
  locale       String    @default("zh-CN")
  timezone     String    @default("Asia/Shanghai")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  userRoles  UserRole[]

  @@unique([tenantId, email])
  @@index([tenantId, deletedAt, status])
}

model Role {
  id          String    @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId, deletedAt])
}

model Permission {
  id     String @id @default(cuid())
  code   String @unique
  name   String
  module String

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model Setting {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  value     Json
  scope     String   @default("TENANT") // TENANT | USER
  userId    String?
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, scope, key, userId])
  @@index([tenantId, key])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  at        DateTime @default(now())

  @@index([tenantId, entity, entityId])
  @@index([tenantId, at])
}

model FieldDefinition {
  id        String    @id @default(cuid())
  tenantId  String
  entity    String
  apiName   String
  label     String
  labelI18n Json?
  dataType  String
  required  Boolean   @default(false)
  options   Json?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tenantId, entity, apiName])
  @@index([tenantId, entity, isActive])
}

// ========== M02 线索 ==========

model Lead {
  id                     String    @id @default(cuid())
  tenantId               String
  name                   String
  contactName            String?
  phone                  String?
  email                  String?
  website                String?
  industry               String?
  source                 String // WEB_FORM|PHONE|REFERRAL|EXHIBITION|COLD_CALL|ADS|PARTNER|OTHER
  campaignId             String?
  status                 String    @default("NEW")
  score                  Int       @default(0)
  ownerId                String
  departmentId           String?
  expectedAmount         Decimal?  @db.Decimal(18, 2)
  remark                 String?
  nextFollowAt           DateTime?
  customValues           Json?
  convertedAt            DateTime?
  convertedAccountId     String?
  convertedContactId     String?
  convertedOpportunityId String?
  closeReason            String?
  createdAt              DateTime  @default(now())
  createdById            String
  updatedAt              DateTime  @updatedAt
  updatedById            String
  deletedAt              DateTime?
  deletedById            String?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, deletedAt, ownerId, status, nextFollowAt])
  @@index([tenantId, campaignId])
}

// ========== M03 客户联系人 ==========

model Account {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  shortName       String?
  accountNo       String?
  industry        String?
  scale           String? // MICRO|SMALL|MEDIUM|LARGE|ENTERPRISE
  region          String?
  address         String?
  website         String?
  phone           String?
  level           String    @default("C") // A|B|C|D
  stage           String    @default("POTENTIAL") // POTENTIAL|ACTIVE|AT_RISK|CHURNED
  ownerId         String
  departmentId    String?
  parentAccountId String?
  source          String?
  annualRevenue   Decimal?  @db.Decimal(18, 2)
  remark          String?
  lastActivityAt  DateTime?
  customValues    Json?
  createdAt       DateTime  @default(now())
  createdById     String
  updatedAt       DateTime  @updatedAt
  updatedById     String
  deletedAt       DateTime?
  deletedById     String?

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  parentAccount Account?      @relation("AccountTree", fields: [parentAccountId], references: [id])
  childAccounts Account[]     @relation("AccountTree")
  contacts      Contact[]
  opportunities Opportunity[]
  contracts     Contract[]

  @@index([tenantId, deletedAt, ownerId, name])
  @@index([tenantId, parentAccountId])
}

model Contact {
  id              String    @id @default(cuid())
  tenantId        String
  accountId       String
  name            String
  title           String?
  phone           String?
  mobile          String?
  email           String?
  isPrimary       Boolean   @default(false)
  influence       Int? // 决策影响力 0-100
  decisionRole    String? // ECONOMIC|USER|TECH|CHAMPION|OTHER
  birthDate       DateTime? @db.Date
  wechat          String?
  preferredLocale String?
  remark          String?
  createdAt       DateTime  @default(now())
  createdById     String
  updatedAt       DateTime  @updatedAt
  updatedById     String
  deletedAt       DateTime?
  deletedById     String?

  account Account @relation(fields: [accountId], references: [id])

  @@index([tenantId, deletedAt, accountId])
  @@index([tenantId, mobile])
  @@index([tenantId, email])
}

model EntityShare {
  id          String   @id @default(cuid())
  tenantId    String
  entityType  String // ACCOUNT|LEAD|OPPORTUNITY|CONTRACT
  entityId    String
  userId      String
  role        String // COLLABORATOR|VIEWER
  createdAt   DateTime @default(now())
  createdById String

  @@unique([tenantId, entityType, entityId, userId])
  @@index([tenantId, userId, entityType])
}

// ========== M04 商机 ==========

model Pipeline {
  id        String    @id @default(cuid())
  tenantId  String
  code      String
  name      String
  isDefault Boolean   @default(false)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  stages        PipelineStage[]
  opportunities Opportunity[]

  @@unique([tenantId, code])
  @@index([tenantId, deletedAt])
}

model PipelineStage {
  id             String   @id @default(cuid())
  tenantId       String
  pipelineId     String
  code           String
  name           String
  winRate        Int      @default(0)
  sortOrder      Int      @default(0)
  isClosing      Boolean  @default(false)
  requiredFields Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pipeline Pipeline @relation(fields: [pipelineId], references: [id])

  opportunities Opportunity[]

  @@unique([tenantId, pipelineId, code])
  @@index([pipelineId, sortOrder])
}

model Opportunity {
  id                String    @id @default(cuid())
  tenantId          String
  name              String
  accountId         String
  primaryContactId  String?
  pipelineId        String
  stageId           String
  amount            Decimal   @default(0) @db.Decimal(18, 2)
  /// 币种（空 = 写入时由触发器填为租户本位币）；amountBase 为折算本位币金额（触发器按汇率表计算）
  currency          String    @default("")
  amountBase        Decimal   @default(0) @db.Decimal(18, 2)
  winRate           Int       @default(0)
  expectedCloseDate DateTime  @db.Date
  ownerId           String
  departmentId      String?
  source            String?
  competitor        String?
  nextStep          String?
  nextFollowAt      DateTime?
  closeReason       String?
  description       String?
  actualCloseDate   DateTime? @db.Date
  leadId            String?
  campaignId        String?
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  createdById       String
  updatedAt         DateTime  @updatedAt
  updatedById       String
  deletedAt         DateTime?
  deletedById       String?

  account   Account                   @relation(fields: [accountId], references: [id])
  pipeline  Pipeline                  @relation(fields: [pipelineId], references: [id])
  stage     PipelineStage             @relation(fields: [stageId], references: [id])
  members   OpportunityMember[]
  histories OpportunityStageHistory[]
  quotes    Quote[]
  contracts Contract[]

  @@index([tenantId, deletedAt, stageId, expectedCloseDate])
  @@index([tenantId, accountId])
  @@index([tenantId, ownerId, deletedAt])
}

model OpportunityMember {
  opportunityId String
  userId        String
  role          String // COLLABORATOR|INFLUENCER
  createdAt     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  @@id([opportunityId, userId])
  @@index([userId])
}

model OpportunityStageHistory {
  id            String   @id @default(cuid())
  tenantId      String
  opportunityId String
  fromStageId   String?
  toStageId     String
  fromWinRate   Int?
  toWinRate     Int?
  changedById   String
  changedAt     DateTime @default(now())
  note          String?

  opportunity Opportunity @relation(fields: [opportunityId], references: [id])

  @@index([opportunityId, changedAt])
}

// ========== M05 活动 ==========

model Activity {
  id             String    @id @default(cuid())
  tenantId       String
  type           String // TASK|VISIT|CALL|EMAIL|NOTE
  subject        String
  status         String    @default("PLANNED") // PLANNED|DONE|CANCELED
  startAt        DateTime?
  endAt          DateTime?
  dueAt          DateTime?
  entityType     String // LEAD|ACCOUNT|CONTACT|OPPORTUNITY|TICKET
  entityId       String
  ownerId        String
  content        String?
  location       String?
  checkInLat     Decimal?  @db.Decimal(10, 7)
  checkInLng     Decimal?  @db.Decimal(10, 7)
  checkInAt      DateTime?
  checkInAddress String?
  remindAt       DateTime?
  source         String    @default("MANUAL") // MANUAL|AUTO|API|CADENCE
  createdAt      DateTime  @default(now())
  createdById    String
  updatedAt      DateTime  @updatedAt
  updatedById    String
  deletedAt      DateTime?
  deletedById    String?

  @@index([tenantId, deletedAt, entityType, entityId, startAt])
  @@index([tenantId, ownerId, status, dueAt])
  @@index([tenantId, remindAt])
}

// ========== M06 产品报价 ==========

model Product {
  id            String    @id @default(cuid())
  tenantId      String
  code          String
  name          String
  category      String?
  unit          String    @default("个")
  description   String?
  isActive      Boolean   @default(true)
  standardPrice Decimal   @db.Decimal(18, 2)
  cost          Decimal?  @db.Decimal(18, 2)
  taxRate       Decimal   @default(0) @db.Decimal(5, 4)
  createdAt     DateTime  @default(now())
  createdById   String
  updatedAt     DateTime  @updatedAt
  updatedById   String
  deletedAt     DateTime?
  deletedById   String?

  prices        ProductPrice[]
  quoteLines    QuoteLine[]
  contractLines ContractLine[]

  @@unique([tenantId, code])
  @@index([tenantId, deletedAt, isActive])
}

model ProductPrice {
  id            String    @id @default(cuid())
  tenantId      String
  productId     String
  priceBookName String    @default("standard")
  unitPrice     Decimal   @db.Decimal(18, 2)
  currency      String    @default("CNY")
  validFrom     DateTime? @db.Date
  validTo       DateTime? @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@unique([tenantId, productId, priceBookName, currency])
}

model Quote {
  id             String    @id @default(cuid())
  tenantId       String
  quoteNo        String
  opportunityId  String?
  accountId      String
  subject        String
  status         String    @default("DRAFT")
  currency       String    @default("")
  subtotal       Decimal   @default(0) @db.Decimal(18, 2)
  discountAmount Decimal   @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal   @default(0) @db.Decimal(18, 2)
  total          Decimal   @default(0) @db.Decimal(18, 2)
  /// 折算本位币金额（触发器计算）
  totalBase      Decimal   @default(0) @db.Decimal(18, 2)
  validUntil     DateTime? @db.Date
  terms          String?
  remark         String?
  ownerId        String
  projectId      String?
  approvedAt     DateTime?
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  createdById    String
  updatedAt      DateTime  @updatedAt
  updatedById    String
  deletedAt      DateTime?
  deletedById    String?

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  lines       QuoteLine[]
  contracts   Contract[]

  @@unique([tenantId, quoteNo])
  @@index([tenantId, deletedAt, accountId])
  @@index([tenantId, ownerId, status])
  @@index([tenantId, projectId])
}

model QuoteLine {
  id           String  @id @default(cuid())
  tenantId     String
  quoteId      String
  productId    String
  name         String
  qty          Decimal @db.Decimal(18, 4)
  unitPrice    Decimal @db.Decimal(18, 2)
  discountRate Decimal @default(0) @db.Decimal(5, 4)
  amount       Decimal @db.Decimal(18, 2)
  sortOrder    Int     @default(0)
  remark       String?

  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([quoteId, sortOrder])
}

// ========== M07 合同回款 ==========

model Contract {
  id                 String    @id @default(cuid())
  tenantId           String
  contractNo         String
  title              String
  accountId          String
  opportunityId      String?
  quoteId            String?
  projectId          String?
  templateId         String?
  status             String    @default("DRAFT")
  signDate           DateTime? @db.Date
  effectiveDate      DateTime? @db.Date
  expireDate         DateTime? @db.Date
  total              Decimal   @default(0) @db.Decimal(18, 2)
  receivedAmount     Decimal   @default(0) @db.Decimal(18, 2)
  /// 折算本位币金额（触发器按签约日汇率计算）
  totalBase          Decimal   @default(0) @db.Decimal(18, 2)
  receivedAmountBase Decimal   @default(0) @db.Decimal(18, 2)
  currency           String    @default("")
  ownerId            String
  terms              String?
  remark             String?
  fileAttachmentId   String?
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  createdById        String
  updatedAt          DateTime  @updatedAt
  updatedById        String
  deletedAt          DateTime?
  deletedById        String?

  account     Account        @relation(fields: [accountId], references: [id])
  opportunity Opportunity?   @relation(fields: [opportunityId], references: [id])
  quote       Quote?         @relation(fields: [quoteId], references: [id])
  lines       ContractLine[]
  plans       PaymentPlan[]
  payments    Payment[]

  @@unique([tenantId, contractNo])
  @@index([tenantId, deletedAt, accountId])
  @@index([tenantId, ownerId, status])
  @@index([tenantId, projectId])
}

model ContractLine {
  id           String  @id @default(cuid())
  tenantId     String
  contractId   String
  productId    String
  name         String
  qty          Decimal @db.Decimal(18, 4)
  unitPrice    Decimal @db.Decimal(18, 2)
  discountRate Decimal @default(0) @db.Decimal(5, 4)
  amount       Decimal @db.Decimal(18, 2)
  sortOrder    Int     @default(0)
  remark       String?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([contractId, sortOrder])
}

model PaymentPlan {
  id                 String   @id @default(cuid())
  tenantId           String
  contractId         String
  seq                Int
  dueDate            DateTime @db.Date
  amount             Decimal  @db.Decimal(18, 2)
  receivedAmount     Decimal  @default(0) @db.Decimal(18, 2)
  /// 折算本位币金额（触发器按所属合同币种计算）
  amountBase         Decimal  @default(0) @db.Decimal(18, 2)
  receivedAmountBase Decimal  @default(0) @db.Decimal(18, 2)
  status             String   @default("PENDING") // PENDING|PARTIAL|PAID|OVERDUE
  remark             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  contract Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([contractId, seq])
  @@index([tenantId, dueDate, status])
}

model Payment {
  id            String    @id @default(cuid())
  tenantId      String
  paymentNo     String
  contractId    String
  paymentPlanId String?
  amount        Decimal   @db.Decimal(18, 2)
  /// 折算本位币金额（触发器按所属合同币种、回款日汇率计算）
  amountBase    Decimal   @default(0) @db.Decimal(18, 2)
  paidAt        DateTime  @db.Date
  method        String // BANK|CHECK|ALIPAY|WECHAT|OTHER
  status        String    @default("DRAFT")
  bankAccount   String?
  voucherNo     String?
  remark        String?
  confirmedById String?
  confirmedAt   DateTime?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  createdById   String
  updatedAt     DateTime  @updatedAt
  updatedById   String
  deletedAt     DateTime?
  deletedById   String?

  contract    Contract     @relation(fields: [contractId], references: [id])
  paymentPlan PaymentPlan? @relation(fields: [paymentPlanId], references: [id])

  @@unique([tenantId, paymentNo])
  @@index([tenantId, contractId, status])
  @@index([tenantId, paidAt])
}

// ========== M08 工单 ==========

model Ticket {
  id            String    @id @default(cuid())
  tenantId      String
  ticketNo      String
  title         String
  accountId     String
  contactId     String?
  opportunityId String?
  type          String // ISSUE|QUESTION|REQUEST|BUG
  severity      String    @default("MEDIUM")
  status        String    @default("NEW")
  ownerId       String
  dueAt         DateTime?
  resolvedAt    DateTime?
  resolution    String?
  satisfaction  Int?
  createdAt     DateTime  @default(now())
  createdById   String
  updatedAt     DateTime  @updatedAt
  updatedById   String
  deletedAt     DateTime?
  deletedById   String?

  logs TicketLog[]

  @@unique([tenantId, ticketNo])
  @@index([tenantId, deletedAt, status, severity])
  @@index([tenantId, accountId])
}

model TicketLog {
  id         String   @id @default(cuid())
  tenantId   String
  ticketId   String
  fromStatus String?
  toStatus   String
  note       String?
  userId     String
  at         DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, at])
}

// ========== M09 营销 ==========

model Campaign {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  type        String // WEBINAR|EXHIBITION|EMAIL|ADS|OTHER
  status      String    @default("PLANNED")
  startAt     DateTime?
  endAt       DateTime?
  budget      Decimal?  @db.Decimal(18, 2)
  ownerId     String
  description String?
  createdAt   DateTime  @default(now())
  createdById String
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  forms Form[]

  @@index([tenantId, deletedAt, status])
}

model Form {
  id             String    @id @default(cuid())
  tenantId       String
  campaignId     String?
  name           String
  fields         Json
  isActive       Boolean   @default(true)
  submitRedirect String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  campaign    Campaign?        @relation(fields: [campaignId], references: [id])
  submissions FormSubmission[]

  @@index([tenantId, deletedAt, isActive])
}

model FormSubmission {
  id        String   @id @default(cuid())
  tenantId  String
  formId    String
  data      Json
  leadId    String?
  createdAt DateTime @default(now())

  form Form @relation(fields: [formId], references: [id])

  @@index([formId, createdAt])
}

// ========== M10 目标 ==========

model Goal {
  id           String    @id @default(cuid())
  tenantId     String
  userId       String?
  teamId       String?
  periodType   String // MONTH|QUARTER|YEAR
  periodKey    String // e.g. 2026-09
  metric       String // REVENUE|NEW_OPP|WON_AMOUNT
  targetAmount Decimal   @db.Decimal(18, 2)
  createdAt    DateTime  @default(now())
  createdById  String
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([tenantId, periodType, periodKey, metric])
}

model ReportDef {
  id         String    @id @default(cuid())
  tenantId   String
  code       String
  name       String
  module     String
  definition Json
  ownerId    String
  isShared   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@unique([tenantId, code])
}

// ========== M11 审批 ==========

model ApprovalDefinition {
  id         String   @id @default(cuid())
  tenantId   String
  code       String
  name       String
  entityType String // QUOTE|CONTRACT|PAYMENT
  rules      Json
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  instances ApprovalInstance[]

  @@unique([tenantId, code])
}

model ApprovalInstance {
  id           String    @id @default(cuid())
  tenantId     String
  definitionId String
  entityType   String
  entityId     String
  status       String    @default("PENDING")
  currentStep  Int       @default(0)
  applicantId  String
  snapshot     Json
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

