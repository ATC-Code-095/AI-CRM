/// 佣金发放记录：每期每人一条，amount 为确认时的计佣快照
model CommissionPayout {
  id            String   @id @default(cuid())
  tenantId      String
  periodKey     String // YYYY-MM
  userId        String
  userName      String
  amount        Decimal  @db.Decimal(18, 2)
  status        String   @default("PENDING") // PENDING|CONFIRMED|PAID
  note          String   @default("")
  updatedById   String?
  updatedByName String   @default("")
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, periodKey, userId])
}

/// 销售预测提交：每月每人一条
model ForecastCommit {
  id           String   @id @default(cuid())
  tenantId     String
  month        String // YYYY-MM
  userId       String
  userName     String
  commitAmount Decimal  @default(0) @db.Decimal(18, 2)
  bestAmount   Decimal  @default(0) @db.Decimal(18, 2)
  worstAmount  Decimal  @default(0) @db.Decimal(18, 2)
  note         String   @default("")
  submittedAt  DateTime @default(now())

  @@unique([tenantId, month, userId])
}

/// 商机作战卡（每商机一份）
model OpportunityBattlecard {
  id            String   @id @default(cuid())
  tenantId      String
  opportunityId String
  competitors   String   @default("")
  stakeholders  String   @default("")
  winThemes     String   @default("")
  risks         String   @default("")
  actions       Json     @default("[]") // [{text, done}]
  updatedById   String?
  updatedByName String   @default("")
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, opportunityId])
}

/// 续约剧本进度：accountId 为空表示用户自己的全局剧本
model PlaybookProgress {
  id        String   @id @default(cuid())
  tenantId  String
  accountId String?
  userId    String?
  steps     Json     @default("{}") // {stepKey: done}
  updatedAt DateTime @updatedAt

  @@index([tenantId, accountId])
  @@index([tenantId, userId])
}

/// 健康分每日快照：kind=ACCOUNT 时 subjectId 为客户 id；kind=FUNNEL 时为空串
model HealthSnapshot {
  id        String @id @default(cuid())
  tenantId  String
  kind      String // ACCOUNT|FUNNEL
  subjectId String @default("")
  date      String // YYYY-MM-DD
  score     Float
  level     String @default("")

  @@unique([tenantId, kind, subjectId, date])
}

/// 系统健康巡检报告；tenantId 为空表示全系统（定时任务）
model SystemHealthReport {
  id          String   @id @default(cuid())
  tenantId    String?
  generatedAt DateTime @default(now())
  status      String // HEALTHY|ATTENTION
  report      Json

  @@index([tenantId, generatedAt])
}

/// 汇率：1 单位 currency = rate 单位本位币；按 effectiveDate 生效（取单据日期当天或之前最近的一条）
model ExchangeRate {
  id            String   @id @default(cuid())
  tenantId      String
  currency      String
  rate          Decimal  @db.Decimal(18, 8)
  effectiveDate DateTime @db.Date
  /// MANUAL 手工录入 | ECB 欧洲央行参考汇率（自动拉取）
  source        String   @default("MANUAL")
  createdById   String?
  createdAt     DateTime @default(now())

  @@unique([tenantId, currency, effectiveDate])
}

/// 企业微信 / 钉钉 / 飞书账号与 CRM 用户的绑定（通讯录同步或扫码登录时建立）
model UserIdentity {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  /// wechat_work | dingtalk | feishu
  provider   String
  /// 平台内的用户 ID：企业微信 userid、钉钉 userid、飞书 open_id
  externalId String
  createdAt  DateTime @default(now())

  @@unique([tenantId, provider, externalId])
  @@unique([userId, provider])
  @@index([tenantId, userId])
}
