  category        String    @default("")
  description     String    @default("")
  terms           String    @default("")
  defaultDuration String    @default("")
  defaultPayment  String    @default("")
  lines           Json      @default("[]") // 报价模板行：[{productId, name?, qty, unitPrice?, discountRate?}]
