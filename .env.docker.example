# docker compose 使用的配置。复制为 .env.docker 后修改，不要提交到 git。
# 生成随机值：openssl rand -hex 32

# 数据库密码（首次启动时写入，之后修改需同时改数据库内的密码）
POSTGRES_PASSWORD=

# 登录令牌签名密钥，两个不同的随机串，长度至少 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# 首次启动设为 true：写入角色、权限与初始账号；登录确认后改回 false 再重启
AUTO_SEED=true
# 初始账号密码：留空则随机生成，只在 API 日志中显示一次（docker compose logs api | grep 初始密码）
SEED_PASSWORD=

# 网页端口（http://<服务器>:WEB_PORT）
WEB_PORT=8080
# 浏览器访问地址，多个用逗号分隔；同源访问时可不改
CORS_ORIGIN=http://localhost:8080

# 版本号显示用的提交哈希：GIT_COMMIT=$(git rev-parse --short HEAD)
GIT_COMMIT=unknown

# 加密存库的第三方密钥（AI 接口密钥等），openssl rand -hex 32；设置后不要更换
SETTINGS_SECRET=

# AI 助手（可选）：推荐在系统设置里配置；这里是旧方式
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# 手机推送（可选）：.p8 密钥内容（换行写成 \n）与 Firebase 服务账号 JSON
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.itecent.crm
APNS_PRODUCTION=false
FCM_SERVICE_ACCOUNT=
HMS_SERVICE_ACCOUNT=
